<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
	</startup>

	<system.serviceModel>
		<client>
			<endpoint name="ChargingService"
					  address="net.tcp://localhost:8000/ChargingService"
					  binding="netTcpBinding"
					  bindingConfiguration="ChargingBinding"
					  contract="Common.IChargingService" />
		</client>

		<bindings>
			<netTcpBinding>
				<binding name="ChargingBinding"
						 maxReceivedMessageSize="10485760"
						 transferMode="Streamed"
						 receiveTimeout="00:10:00"
						 sendTimeout="00:10:00">
					<security mode="None"/>
				</binding>
			</netTcpBinding>
		</bindings>

	</system.serviceModel>

	<appSettings>
		<!--Dodati putanju na odbrani-->
		<add key="DatasetPath" value="C:\Users\tijan\Downloads\dataverse_files\EV-CPW Dataset"/>
	</appSettings>

</configuration>